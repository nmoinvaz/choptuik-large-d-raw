#!/bin/bash
# Linux stand-in for `taskkill /T /F /PID N` of win2's leap_guard.py: SIGKILL of process N and of all its descendants.
pid=""; while [ $# -gt 0 ]; do [ "$1" = "/PID" ] && pid=$2; shift; done
[ -n "$pid" ] || exit 1
killtree() { local c; for c in $(pgrep -P "$1" 2>/dev/null); do killtree $c; done; kill -9 "$1" 2>/dev/null; }
killtree "$pid"
exit 0
