# read by lane111.sh when the scan starts (appended to point.env): t5's order (hc 26 Nov ~02:13 UTC): "a scan -0.08 to -0.02 by 0.01 plus a repeat"; 8 evaluations on 4 processes of one thread at nice 15,
# round-robin: process 0 -0.05 then -0.06, process 1 the repeat of -0.05 then -0.04, process 2 -0.08 then -0.03, process 3 -0.07 then -0.02
NP=4; GATE=10; NICE=15
LAMP=("-0.05" "-0.05" "-0.08" "-0.07" "-0.06" "-0.04" "-0.03" "-0.02")
WIN="-0.08 -0.02"; REP=-0.05
