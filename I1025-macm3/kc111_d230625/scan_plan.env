# read by lane111.sh when the scan starts (appended to point.env): t5's answer (hc 26 Nov ~02:16 UTC): "scan -0.08 to 0.02 by 0.01 plus a repeat; my window was wrong for my own prediction":
# 11 values and a repeat of -0.01 = 12 evaluations on 4 processes of one thread at nice 15, round-robin, central values first (the register: -0.012):
# process 0 -0.01, -0.03, -0.05; process 1 the repeat of -0.01, 0.01, -0.06; process 2 -0.02, -0.04, -0.07; process 3 0.00, 0.02, -0.08
NP=4; GATE=10; NICE=15
LAMP=("-0.01" "-0.01" "-0.02" "0.00" "-0.03" "0.01" "-0.04" "0.02" "-0.05" "-0.06" "-0.07" "-0.08")
WIN="-0.08 0.02"; REP=-0.01
