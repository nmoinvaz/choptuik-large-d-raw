# the extension scan of kc143_d23125x when the window (-0.030, -0.020) reads '-' at every point (t5's pre-authorization, #1025 hc 27 Nov 08:4x UTC): the plan of the kc143_d23125 scan (-0.040, -0.035 added to the window's three points and the repeat of -0.030)
NP=2; GATE=10; NICE=15
LAMP=("-0.030" "-0.030" "-0.040" "-0.035" "-0.025" "-0.020")
WIN="-0.040 -0.020"; REP=-0.030
