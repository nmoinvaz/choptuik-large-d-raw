# the extension scan of kc143_d23125x when the window (-0.030, -0.020) reads '+' at every point (t5's pre-authorization): -0.015 and -0.010 added to the window's three points and the repeat of -0.030
NP=2; GATE=10; NICE=15
LAMP=("-0.030" "-0.030" "-0.025" "-0.020" "-0.015" "-0.010")
WIN="-0.030 -0.010"; REP=-0.030
