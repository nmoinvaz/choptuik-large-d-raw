# read by lane119.sh when the scan starts (appended to point.env): t5's order (hc 26 Nov ~06:05 UTC): "scan -0.02 to 0.06 by 0.02 (5 points)"; the scan driver requires a repeat on another process, so one repeat of 0.04 is added
# (6 evaluations on 4 processes of one thread at nice 15, round-robin, the register +0.040 first): process 0 0.04 then 0.00; process 1 the repeat of 0.04 then -0.02; process 2 0.02; process 3 0.06
NP=4; GATE=10; NICE=15
LAMP=("0.04" "0.04" "0.02" "0.06" "0.00" "-0.02")
WIN="-0.02 0.06"; REP=0.04
