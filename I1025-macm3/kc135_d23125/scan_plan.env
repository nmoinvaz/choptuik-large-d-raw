# read by lane_d23125.sh when the scan starts (appended to point.env). PROVISIONAL (written with the registration, before the regrid; the final list is fixed in README.md's second registration entry, at the end of the D 23.0625 secant, before the regrid starts):
# the NEW scanner (wip/ell1-speed 92b9bf53, blob eb1396ad), 6 evaluations on 2 processes of one thread at nice 15, round-robin, 3 rounds: process 0 -0.035, -0.040, -0.045; process 1 the repeat of -0.035, -0.030, -0.025
NP=2; GATE=10; NICE=15
LAMP=("-0.035" "-0.035" "-0.040" "-0.030" "-0.045" "-0.025")
WIN="-0.045 -0.025"; REP=-0.035
